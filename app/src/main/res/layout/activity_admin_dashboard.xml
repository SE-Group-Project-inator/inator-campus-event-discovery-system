<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg">

    <!-- ==================== MAIN CONTENT ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== TOP APP BAR ===== -->
        <RelativeLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_admin_header"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <!-- Screen Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.01"/>

                <TextView
                    android:id="@+id/tvAdminSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus-Inator Admin"
                    android:textSize="12sp"
                    android:textColor="#CCffffff"/>
            </LinearLayout>

            <!-- Notifications Bell (right) with unread badge -->
            <FrameLayout
                android:id="@+id/btnAdminAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_notifications"
                    android:contentDescription="Notifications"
                    app:tint="@color/white"/>

                <View
                    android:id="@+id/notifBadge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_reddot"
                    android:visibility="gone"/>
            </FrameLayout>

        </RelativeLayout>

        <!-- ===== SCROLLABLE CONTENT ===== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- WELCOME BANNER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_admin_header"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="28dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good morning, Admin 👋"
                        android:textSize="17sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvInsight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You have pending events to review"
                        android:textSize="13sp"
                        android:textColor="#CCffffff"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <!-- STAT CARDS (pulled up, overlapping header) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginTop="-16dp">

                    <!-- Pending Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:id="@+id/tvPendingCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="@color/admin_warning"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pending"
                                android:textSize="12sp"
                                android:textColor="@color/admin_text_secondary"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Approved Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:id="@+id/tvApprovedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="@color/admin_success"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Approved"
                                android:textSize="12sp"
                                android:textColor="@color/admin_text_secondary"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Total Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:id="@+id/tvTotalCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="@color/admin_primary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total"
                                android:textSize="12sp"
                                android:textColor="@color/admin_text_secondary"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- QUICK ACTIONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Actions"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/admin_text_primary"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- View All Events -->
                        <LinearLayout
                            android:id="@+id/quickActionEvents"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_admin_card_purple"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📋"
                                android:textSize="22sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All Events"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Pending Review -->
                        <LinearLayout
                            android:id="@+id/quickActionPending"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_admin_card_rose"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏳"
                                android:textSize="22sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pending"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Approved -->
                        <LinearLayout
                            android:id="@+id/quickActionApproved"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_admin_card_green"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✅"
                                android:textSize="22sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Approved"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- PENDING EVENTS SECTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="24dp">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pending Reviews"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/admin_text_primary"/>

                        <TextView
                            android:id="@+id/tvSeeAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See all →"
                            android:textColor="@color/admin_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:padding="4dp"/>
                    </LinearLayout>

                    <!-- Filter Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chipAll"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_chip_active"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:gravity="center"
                                android:text="All"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:id="@+id/chipUrgent"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_chip_inactive"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:gravity="center"
                                android:text="🔥 Urgent"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="13sp"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:id="@+id/chipNewest"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_chip_inactive"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:gravity="center"
                                android:text="Newest"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="13sp"
                                android:layout_marginEnd="8dp"/>

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Empty state -->
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎉"
                            android:textSize="40sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All caught up!"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/admin_text_primary"
                            android:layout_marginTop="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No pending events to review"
                            android:textSize="13sp"
                            android:textColor="@color/admin_text_secondary"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Events RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPendingEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ══════════════ PREMIUM BOTTOM NAV — ADMIN ══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_bottom_nav"
            android:elevation="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Dashboard (active) -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_nav_item_active">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_dashboard"
                        app:tint="@color/admin_primary"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/admin_primary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Events -->
            <LinearLayout
                android:id="@+id/navEvents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_events"
                    app:tint="@color/admin_nav_inactive"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Events"
                    android:textSize="10sp"
                    android:textColor="@color/admin_nav_inactive"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <!-- Notifications -->
            <LinearLayout
                android:id="@+id/navNotifications"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_notifications"
                    app:tint="@color/admin_nav_inactive"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alerts"
                    android:textSize="10sp"
                    android:textColor="@color/admin_nav_inactive"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/admin_nav_inactive"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="10sp"
                    android:textColor="@color/admin_nav_inactive"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ===== ADMIN PROFILE BOTTOM SHEET ===== -->
    <FrameLayout
        android:id="@+id/profileSheetScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/admin_scrim"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/adminProfileSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:translationY="1000dp"
        android:elevation="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:background="@color/admin_divider"/>

        <!-- Avatar + Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">
                <TextView
                    android:id="@+id/tvSheetAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_admin_avatar"
                    android:gravity="center"
                    android:text="A"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvSheetAdminName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/admin_text_primary"
                android:layout_marginTop="12dp"/>

            <!-- Role Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_role_badge"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Super Admin"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/admin_divider"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>

        <!-- Info Rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp">

            <!-- Email Row -->
            <LinearLayout
                android:id="@+id/rowEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_info_row"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="✉️"
                    android:textSize="16sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="10sp"
                        android:textColor="@color/admin_text_hint"/>
                    <TextView
                        android:id="@+id/tvSheetEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="admin@campus.edu"
                        android:textSize="14sp"
                        android:textColor="@color/admin_text_primary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Organization Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_info_row"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="🏛️"
                    android:textSize="16sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Organization"
                        android:textSize="10sp"
                        android:textColor="@color/admin_text_hint"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LUMS Campus"
                        android:textSize="14sp"
                        android:textColor="@color/admin_text_primary"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/admin_divider"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>

        <!-- Logout Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:id="@+id/btnSheetLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_logout_btn"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚪"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign Out"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/admin_error"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

