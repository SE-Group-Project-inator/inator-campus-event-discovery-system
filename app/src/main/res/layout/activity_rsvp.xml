<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EBF8F5"
    android:fitsSystemWindows="true">

    <!-- Teal Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D9488"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rsvp_confirmation"
            android:textColor="#B2F0EB"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvEventTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tech_fest_2025"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅  " android:textSize="12sp"/>
            <TextView android:id="@+id/tvEventHeaderDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tuesday_17_march_2025" android:textSize="12sp" android:textColor="#B2F0EB"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍  " android:textSize="12sp"/>
            <TextView android:id="@+id/tvEventHeaderVenue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hss_room_a8_lums" android:textSize="12sp" android:textColor="#B2F0EB"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Form and success areas wrapped in a FrameLayout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RSVP Form -->
        <LinearLayout
            android:id="@+id/layoutRsvpForm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <!-- Registration Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/your_registration" android:textSize="11sp" android:textStyle="bold" android:textColor="#0D9488" android:layout_marginBottom="4dp"/>
                            <TextView android:id="@+id/tvCardEventTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tech_fest_2025" android:textStyle="bold" android:textSize="16sp" android:textColor="#134E4A" android:layout_marginBottom="16dp"/>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="@string/date" android:textColor="#94A3B8" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvCardDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/eventDate" android:textColor="#134E4A" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="@string/time" android:textColor="#94A3B8" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvCardTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/eventTime" android:textColor="#134E4A" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="@string/venue" android:textColor="#94A3B8" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvCardVenue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/eventVenue" android:textColor="#134E4A" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Consent Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/i_consent_to" android:textStyle="bold" android:textColor="#134E4A" android:textSize="13sp" android:layout_marginBottom="8dp"/>
                            <CheckBox android:id="@+id/cbVisibleName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#475569" android:text="@string/my_name_being_visible_to_other_participants" android:buttonTint="#0D9488"/>
                            <CheckBox android:id="@+id/cbVisibleRollNo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#475569" android:text="@string/my_roll_number_being_visible_to_other_participants" android:buttonTint="#0D9488"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <CheckBox
                        android:id="@+id/cbWaitlist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textSize="12sp"
                        android:textColor="#0D9488"
                        android:textStyle="bold"
                        android:buttonTint="#0D9488"
                        android:text="@string/add_me_to_the_waitlist_if_slots_are_full"/>
                </LinearLayout>
            </ScrollView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmRsvp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="@string/confirm_rsvp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="#0D9488"
                    app:cornerRadius="14dp"/>
                <TextView android:id="@+id/tvCancellationDeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cancellationDeadline" android:textAlignment="center" android:textSize="10sp" android:layout_marginTop="8dp" android:textColor="#94A3B8"/>
            </LinearLayout>
        </LinearLayout>

        <!-- RSVP Success -->
        <LinearLayout
            android:id="@+id/layoutRsvpSuccess"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Success Banner -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#D1FAE5" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/you_are_registered" android:textColor="#065F46" android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/your_registration" android:textSize="11sp" android:textStyle="bold" android:textColor="#0D9488" android:layout_marginBottom="4dp"/>
                            <TextView android:id="@+id/tvCardEventTitleSuccess" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tech_fest_2025" android:textStyle="bold" android:textSize="16sp" android:textColor="#134E4A" android:layout_marginBottom="16dp"/>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="@string/date" android:textColor="#94A3B8" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvCardDateSuccess" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tuesday_17_march_2025" android:textColor="#134E4A" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="@string/time" android:textColor="#94A3B8" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvCardTimeSuccess" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_10_00_am_4_00_pm" android:textColor="#134E4A" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="@string/venue" android:textColor="#94A3B8" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvCardVenueSuccess" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hss_room_a8_lums" android:textColor="#134E4A" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddToCalendar" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Add to Calendar" android:textColor="@color/white" android:textSize="10sp" app:backgroundTint="#0D9488" app:cornerRadius="8dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </ScrollView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDone" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/done" android:textColor="@color/white" android:textStyle="bold" app:backgroundTint="#0D9488" app:cornerRadius="14dp" android:layout_marginBottom="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelRsvp" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/cancel_rsvp" android:textColor="@color/red_decline" app:backgroundTint="#FEE2E2" app:cornerRadius="14dp"/>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
