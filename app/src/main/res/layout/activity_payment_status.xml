<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBF8F5"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header teal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0D9488"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="44dp"
            android:paddingBottom="20dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <ImageButton
                android:id="@+id/btnStatusBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="#1AFFFFFF"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF"
                android:padding="8dp"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Registration Status"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

            <!-- Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStatusMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FEF3C7"
                android:layout_marginBottom="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <ProgressBar android:id="@+id/progressBarStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="8dp"/>

                    <TextView android:id="@+id/tvStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏳ Pending Verification" android:textColor="#92400E" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:layout_marginBottom="12dp"/>
                    <TextView android:id="@+id/tvStatusDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your payment screenshot has been submitted and is under review." android:textColor="#78350F" android:textSize="14sp" android:gravity="center" android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rejection reason -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRejection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FEE2E2"
                app:cardElevation="0dp"
                android:layout_marginBottom="18dp"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reason for Rejection" android:textColor="#991B1B" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/tvRejectionReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#7F1D1D" android:textSize="14sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Payment details -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp"
                android:layout_marginBottom="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Payment Details" android:textColor="#134E4A" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Event" android:textColor="#64748B" android:textSize="14sp"/>
                        <TextView android:id="@+id/tvStatusEventName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="—" android:textColor="#134E4A" android:textSize="14sp" android:textStyle="bold" android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Method" android:textColor="#64748B" android:textSize="14sp"/>
                        <TextView android:id="@+id/tvStatusPaymentMethod" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="—" android:textColor="#134E4A" android:textSize="14sp" android:textStyle="bold" android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Amount" android:textColor="#64748B" android:textSize="14sp"/>
                        <TextView android:id="@+id/tvStatusAmount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="—" android:textColor="#0D9488" android:textSize="16sp" android:textStyle="bold" android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewTickets"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🎟️ View My Tickets"
                android:textColor="#FFFFFF"
                app:backgroundTint="#10B981"
                app:cornerRadius="14dp"
                android:layout_marginBottom="12dp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCalendar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📅 Export to Calendar"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6366F1"
                app:cornerRadius="14dp"
                android:layout_marginBottom="12dp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewMyPayments"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📋 View All My Payments"
                android:textColor="#0D9488"
                app:backgroundTint="#E0F7F4"
                app:cornerRadius="14dp"
                android:layout_marginBottom="12dp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoHome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🏠 Back to Home"
                android:textColor="#FFFFFF"
                app:backgroundTint="#0D9488"
                app:cornerRadius="14dp"
                android:layout_marginBottom="32dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
