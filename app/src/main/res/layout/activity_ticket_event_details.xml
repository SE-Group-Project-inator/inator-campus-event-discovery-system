<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EBF8F5"
    android:fitsSystemWindows="true">

    <!-- Teal Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D9488"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_arrow_back" android:background="#1AFFFFFF" app:tint="@color/white" android:contentDescription="Back" android:scaleType="fitCenter" android:padding="8dp"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <View android:layout_width="38dp" android:layout_height="38dp"/>
        </LinearLayout>

        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Event Title" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:maxLines="2" android:layout_marginBottom="10dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅  " android:textSize="13sp"/>
            <TextView android:id="@+id/tvHeaderDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date TBD" android:textColor="#B2F0EB" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍  " android:textSize="13sp"/>
            <TextView android:id="@+id/tvHeaderVenue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Venue TBD" android:textColor="#B2F0EB" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#EBF8F5" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- Details Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVENT DETAILS" android:textSize="11sp" android:textColor="#0D9488" android:letterSpacing="0.1" android:textStyle="bold" android:layout_marginBottom="14dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <androidx.cardview.widget.CardView android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="12dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="#E0F2FE" app:cardElevation="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="📅" android:textSize="17sp"/></androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date" android:textSize="11sp" android:textColor="#94A3B8"/>
                            <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TBD" android:textColor="#134E4A" android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <androidx.cardview.widget.CardView android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="12dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="#F0FDF4" app:cardElevation="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="⏰" android:textSize="17sp"/></androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time" android:textSize="11sp" android:textColor="#94A3B8"/>
                            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="#134E4A" android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <androidx.cardview.widget.CardView android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="12dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="#FEF3C7" app:cardElevation="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="📍" android:textSize="17sp"/></androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Venue" android:textSize="11sp" android:textColor="#94A3B8"/>
                            <TextView android:id="@+id/tvVenue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TBD" android:textColor="#134E4A" android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <androidx.cardview.widget.CardView android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="12dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="#F0FDF4" app:cardElevation="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="👥" android:textSize="17sp"/></androidx.cardview.widget.CardView>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Capacity" android:textSize="11sp" android:textColor="#94A3B8"/>
                            <TextView android:id="@+id/tvCapacity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 0 spots taken" android:textColor="#134E4A" android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Availability Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Availability" android:textColor="#134E4A" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvAvailabilityLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#0D9488" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <ProgressBar android:id="@+id/progressAvailability" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:progress="0" android:progressTint="#0D9488" android:progressBackgroundTint="#E2E8F0" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/tvFilling" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 Filling up fast!" android:textColor="#F59E0B" android:textSize="12sp" android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- About -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:id="@+id/layoutAboutToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:padding="2dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ABOUT THIS EVENT" android:textSize="11sp" android:textColor="#0D9488" android:letterSpacing="0.1" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvAboutArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▲" android:textColor="#94A3B8" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="No description provided." android:textColor="#475569" android:textSize="13sp" android:lineSpacingMultiplier="1.5"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Show QR button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShowQR"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="🎟  Show My QR Code"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#0D9488"
        app:cornerRadius="0dp"/>

    <!-- Cancel RSVP button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelRsvp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Cancel RSVP"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/red_decline"
        app:cornerRadius="0dp"/>

</LinearLayout>
