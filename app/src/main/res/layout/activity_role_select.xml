<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_beige"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/lums_logo"
            android:contentDescription="LUMS Logo"
            android:scaleType="fitCenter"/>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campus-Inator"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginTop="16dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse, create or register for your favourite events!"
            android:textSize="14sp"
            android:textColor="@color/text_dark"
            android:gravity="center"
            android:alpha="0.7"
            android:layout_marginTop="8dp"/>

        <!-- Welcome Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="@color/card_tan"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome!"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Are you a..."
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:alpha="0.6"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="28dp"/>

                <!-- Student Button -->
                <Button
                    android:id="@+id/btnStudent"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Student"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/btn_student"
                    android:layout_marginBottom="12dp"/>

                <!-- Event Manager Button -->
                <Button
                    android:id="@+id/btnEventManager"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Event Manager"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/btn_eventmgr"
                    android:layout_marginBottom="12dp"/>

                <!-- Admin Button -->
                <Button
                    android:id="@+id/btnAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Admin"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/btn_admin"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Terms -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By signing in, you agree to the Terms of Use &amp; Privacy Policy."
            android:textSize="11sp"
            android:textColor="@color/text_dark"
            android:alpha="0.6"
            android:gravity="center"
            android:layout_marginTop="28dp"/>

    </LinearLayout>
</ScrollView>