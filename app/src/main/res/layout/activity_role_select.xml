<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- 🔥 HERO CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#F8FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/app_logo"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luminite-Link"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginTop="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't miss the vibe."
                    android:textSize="13sp"
                    android:textColor="@color/text_dark"
                    android:alpha="0.6"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ✨ TAGLINE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Browse. Create. Experience events like never before."
            android:textSize="15sp"
            android:textColor="@color/text_dark"
            android:gravity="center"
            android:alpha="0.75"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="6dp"/>

        <!-- 💎 ACTION CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose your role"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue as"
                    android:textSize="13sp"
                    android:textColor="@color/text_dark"
                    android:alpha="0.6"
                    android:layout_marginBottom="22dp"/>

                <!-- 🎯 BUTTONS -->
                <Button
                    android:id="@+id/btnStudent"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Student"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/btn_student"
                    android:layout_marginBottom="14dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/btnEventManager"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Event Manager"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/btn_eventmgr"
                    android:layout_marginBottom="14dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/btnAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Admin"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/btn_admin"
                    android:stateListAnimator="@null"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 📄 FOOTER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By continuing, you agree to Terms &amp; Privacy Policy"
            android:textSize="11sp"
            android:textColor="@color/text_dark"
            android:alpha="0.5"
            android:gravity="center"
            android:layout_marginTop="30dp"/>

    </LinearLayout>
</ScrollView>