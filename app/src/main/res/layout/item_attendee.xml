<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Circular avatar with initials -->
    <androidx.cardview.widget.CardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        app:cardCornerRadius="22dp"
        app:cardBackgroundColor="@color/btn_eventmgr"
        app:cardElevation="0dp">
        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- Name - RollNumber -->
    <TextView
        android:id="@+id/tvAttendeeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Name - 00000000"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Hidden roll number field kept for search compatibility -->
    <TextView
        android:id="@+id/tvRollNumber"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Confirm button — visible only in event manager view (US-32) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="+ Register"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/btn_eventmgr"
        android:visibility="gone"
        app:cornerRadius="6dp" />

</LinearLayout>
