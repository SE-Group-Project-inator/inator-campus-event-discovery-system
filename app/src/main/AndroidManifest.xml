<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase needs internet -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Campus-Inator"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusEventDiscoverySystem">

        <!-- First screen when app opens -->
        <activity
            android:name=".activities.RoleSelectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Keep MainActivity so teammates don't lose their work -->
        <activity android:name=".MainActivity"/>

        <!-- Login — pinned to a Light theme so dark-mode devices don't render
             white text on the white form fields (boxBackgroundColor is forced white). -->
        <activity android:name=".activities.LoginActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>
        <activity android:name=".activities.AdminDashboardActivity"
            android:theme="@style/Theme.Admin"/>
        <activity android:name=".activities.EventsListActivity"
            android:theme="@style/Theme.Admin"/>
        <activity android:name=".activities.PrivacySettingsActivity"/>
        <activity android:name=".activities.SignupActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>

        <activity android:name=".activities.EventManagerDashboardActivity"/>
        <activity android:name=".activities.ManageEventActivity"/>
<!--        <activity android:name=".activities.EditEventActivity"/>-->
        <activity android:name=".activities.RsvpActivity"/>
        <activity android:name=".activities.NotificationsActivity"/>
        <activity android:name=".activities.EventHistoryActivity"/>
        <activity android:name=".activities.EventManagerProfileActivity"/>
        <activity android:name=".activities.EventManagerEventsActivity"/>

        <activity android:name=".activities.StudentProfileActivity" android:theme="@style/Theme.Student"/>
        <activity android:name=".activities.StudentHomeActivity" android:theme="@style/Theme.Student"/>
        <activity android:name=".activities.SearchActivity" android:theme="@style/Theme.Student"/>

        <!-- US-22: Personalised Recommendations + first-login interest capture -->
        <activity android:name=".activities.StudentOnboardingActivity" android:theme="@style/Theme.Student"/>
        <activity android:name=".activities.RecommendationsActivity" android:theme="@style/Theme.Student"/>

        <!-- US-28: Campus AI Assistant -->
        <activity android:name=".activities.CampusAssistantActivity" android:theme="@style/Theme.Student"/>

        <!-- US-10: Trending Events (Student home) -->
        <activity android:name=".activities.TrendingEventsActivity"/>
        <!-- US-21: Event Detail + Calendar Export -->
        <activity android:name=".activities.EventDetailActivity" android:theme="@style/Theme.Student"/>
        <!-- US-27 / US-32: Attendee List + Seat Confirmation -->
        <activity android:name=".activities.AttendeeListActivity"/>

        <!-- Payment Module -->
        <activity android:name=".activities.PaymentActivity" android:theme="@style/Theme.Student"/>
        <activity android:name=".activities.PaymentStatusActivity" android:theme="@style/Theme.Student"/>
        <activity android:name=".activities.PaymentVerificationActivity"/>
        <activity android:name=".activities.MyPaymentsActivity" android:theme="@style/Theme.Student"/>

        <!-- Tickets / History -->
        <activity android:name=".activities.TicketsActivity"/>
        <activity android:name=".activities.TicketEventDetailsActivity"/>
        <activity android:name=".activities.EventDisplayActivity"/>

        <!-- QR scanner -->
        <activity android:name=".activities.StudentQRActivity"/>
        <activity android:name=".activities.QRScannerActivity"/>

        <!-- Societies -->
        <activity android:name=".activities.SocietiesActivity"/>
        <activity android:name=".activities.MySocietiesActivity"/>
        <activity android:name=".activities.SocietyDetailActivity"/>

        <activity android:name=".activities.AttendeesRosterActivity"/>
        <activity android:name=".activities.EventAnalyticsActivity"/>


    </application>
</manifest>